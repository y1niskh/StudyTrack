# Racine de l'API Express. "/api" passe par le proxy de Vite (vite.config.ts) vers http://localhost:5000 : pas de CORS en développement.
# En production : l'URL complète du backend, par exemple https://studytrack-api.exemple.com/api
VITE_API_URL=/api
# true = fausse API dans le navigateur (src/services/mock.ts) ; false = vrai backend
VITE_USE_MOCK=false
