# Copier en .env (jamais commité) et remplir.
# Supabase > Connect > Session pooler (IPv4). Mot de passe long et aléatoire.
DATABASE_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Secret de signature des jetons : au moins 64 caractères aléatoires.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# E-mails autorisés à créer un compte, séparés par des virgules. Vide = inscriptions fermées.
ALLOWED_EMAILS=
PORT=5000
